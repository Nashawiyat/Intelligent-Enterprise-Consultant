CREATE TABLE BankAccounts (
  accountID INTEGER PRIMARY KEY AUTOINCREMENT,
  accountName TEXT NOT NULL,
  ibancode TEXT,
  currentBalance DECIMAL(15, 2) DEFAULT 0.00,
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE Transactions (
  transactionID INTEGER PRIMARY KEY AUTOINCREMENT,
  accountID INTEGER NOT NULL,
  amount DECIMAL(15, 2) NOT NULL,
  supplierID INT,   -- as these are in another database, no foreign key can be implemented
  customerID INT,
  transactionType TEXT,
  description TEXT,
  -- 
  FOREIGN KEY (accountID) REFERENCES BankAccounts(accountID)

  transactionDate DATETIME DEFAULT CURRENT_TIMESTAMP,
);



CREATE TABLE OperationalCosts (
  costID INTEGER PRIMARY KEY AUTOINCREMENT,
  description TEXT NOT NULL,
  amount DECIMAL(10, 2) NOT NULL,
  frequency TEXT CHECK(frequency IN ('one-time', 'monthly', 'yearly')),
  dueDate DATETIME,
  isPaid BOOLEAN DEFAULT 0,
  category TEXT -- e.g., 'Marketing', 'Rent', 'IT'
);
