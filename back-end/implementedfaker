        cur.execute("""INSERT INTO Transactions (accountID, customerID, supplierID, orderID, taxAmount, netAmount, grossAmount, 
                                                 dueDATE, direction, status) 
                       VALUES (?, ?, NULL, ?, ?, ?, ?, ?, 'IN', 'completed')""",
                    (random.choice(bank_ids), c_id, co_id, round(total - net, 2), net, total, datetime.now().date()))

    for po_id in porder_ids:
        cur.execute("SELECT supplierID, finalPrice FROM POrders WHERE pOrderID = ?", (po_id,))
        row = cur.fetchone()
        if not row:
            continue  # Skip if order not found

        supplier_id, total = row

        net = round(total / 1.15, 2)
        tax = round(total - net, 2)

        cur.execute("""INSERT INTO Transactions (accountID, customerID, supplierID, orderID, taxAmount, netAmount, grossAmount, 
                                                 dueDATE, direction, status)
                         VALUES (?, NULL, ?, ?, ?, ?, ?, ?, 'OUT', 'completed')""",
                   (random.choice(bank_ids), supplier_id, po_id, tax, net, total, datetime.now().date()))

    # ProductionOrder
    for o_id in order_ids[:10]:  # first 10 orders
        cur.execute("SELECT productID FROM COrders WHERE cOrderID=?", (o_id,))
        p_id = cur.fetchone()[0]
        cur.execute("INSERT INTO ProductionOrder (productID, cOrderID, startDate, endDate, comments) VALUES (?, ?, ?)",
                    (p_id, o_id, (datetime.now().date() + timedelta(days=random.randint(1, 10))),
                     (datetime.now().date() + timedelta(days=random.randint(15, 30))), "Automated production entry"))

    # tables 19/ 19

    # closing population
    conn.commit()
    conn.close()
    print("Database population complete.")

if __name__ == "__main__":
    populate()