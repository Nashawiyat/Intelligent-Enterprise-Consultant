            hist_date = datetime.now() - timedelta(days=days_ago)
            hist_price = round(current_price * random.uniform(0.85, 0.95), 2)
            cur.execute("""INSERT INTO PriceHistory (productID, oldPrice, startDate)
                     VALUES (?, ?, ?)""",
                       (p_id, hist_price, hist_date.date()))

    # tables 17/ 19

    # Step 6
    # Transactions, ProductionOrders

