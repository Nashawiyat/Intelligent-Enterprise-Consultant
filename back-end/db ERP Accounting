CREATE TABLE BankAccounts (
  accountID INTEGER PRIMARY KEY AUTOINCREMENT,
  accountName TEXT NOT NULL,
  ibancode TEXT,
  currentBalance DECIMAL(15, 2) DEFAULT 0.00,
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE BankAccountsHistory (
  logID INTEGER PRIMARY KEY AUTOINCREMENT,
  accountID INTEGER NOT NULL,
  balance DECIMAL(15, 2) NOT NULL,
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (accountID) REFERENCES BankAccounts(accountID)
);

CREATE TABLE Creditors (
  creditorID INTEGER PRIMARY KEY AUTOINCREMENT,
  creditorName TEXT NOT NULL,
  ibancode TEXT,
  totalAmount DECIMAL(15, 2) NOT NULL DEFAULT 0.00, 
  contactName TEXT NOT NULL,
  phoneNumber TEXT NOT NULL,
  category TEXT CHECK(category IN ('supplier', 'utilities', 'services', 'government')) DEFAULT 'supplier',
  isActive BOOLEAN DEFAULT 1, 
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE Debtors (
  debtorID INTEGER PRIMARY KEY AUTOINCREMENT,
  customerID INTEGER, 
  debtorName TEXT NOT NULL,
  ibancode TEXT,
  totalAmount DECIMAL(15, 2) NOT NULL DEFAULT 0.00, 
  contactName TEXT NOT NULL,
  phoneNumber TEXT NOT NULL,
  category TEXT CHECK(category IN ('B2C customer', 'B2B customer', 'government', 'affiliates')) DEFAULT 'B2C customer',
  isActive BOOLEAN DEFAULT 1,
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE Transactions (
  transactionID INTEGER PRIMARY KEY AUTOINCREMENT,
  accountID INTEGER NOT NULL,
  taxAmount DECIMAL(15, 2) NOT NULL,
  netAmount DECIMAL(15, 2) NOT NULL,
  grossAmount DECIMAL(15, 2) NOT NULL, -- Added for reporting
  dueDATE DATETIME NOT NULL,
  paidAmount DECIMAL(15, 2) DEFAULT 0.00,
  paidAt DATETIME DEFAULT NULL,
  comments TEXT,
  direction TEXT CHECK(direction IN ('IN', 'OUT')) NOT NULL,
  creditorID INTEGER,
  debtorID INTEGER,
  transactionType TEXT, 
  status TEXT CHECK(status IN ('pending', 'completed')) DEFAULT 'pending',
  transactionDate DATETIME DEFAULT CURRENT_TIMESTAMP,

  -- Enforcement: IN must have a Debtor, OUT must have a Creditor
  CONSTRAINT direction_party_check CHECK (
    (direction = 'IN' AND debtorID IS NOT NULL AND creditorID IS NULL) OR
    (direction = 'OUT' AND creditorID IS NOT NULL AND debtorID IS NULL)
  ),
  
  FOREIGN KEY (accountID) REFERENCES BankAccounts(accountID),
  FOREIGN KEY (creditorID) REFERENCES Creditors(creditorID),
  FOREIGN KEY (debtorID) REFERENCES Debtors(debtorID)
);
