-- db Purchasing (ERP)

CREATE TABLE Supplier (
  -- supplier details
  supplierID INTEGER PRIMARY KEY AUTOINCREMENT,
  --  creditorID INTEGER,		
  companyName TEXT NOT NULL,
  streetAddress TEXT NOT NULL,
  postcode TEXT NOT NULL,
  city TEXT NOT NULL,
  state TEXT NOT NULL,
  country TEXT NOT NULL,
  
  -- contact person
  firstName TEXT NOT NULL,
  lastName TEXT NOT NULL,
  email TEXT UNIQUE NOT NULL,
  telephone TEXT NOT NULL,
  
  -- creditor details
  ibancode TEXT,
  currentBalance DECIMAL(15, 2) NOT NULL DEFAULT 0.00,
  category TEXT CHECK(category IN ('supplier', 'utilities', 'services', 'government')) DEFAULT 'supplier',

  -- is company still customer
  isActive BOOLEAN DEFAULT 1,
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE Components (
  componentID INTEGER PRIMARY KEY AUTOINCREMENT,
  componentName TEXT NOT NULL,
  stockQuantity INTEGER NOT NULL DEFAULT 0,
  unitPrice DECIMAL(10, 2) NOT NULL,
  category TEXT CHECK(category IN ('housing', 'tech', 'wires', 'contacts', 'actuator', 'fastener', 'chip', 'undefined')) DEFAULT 'undefined',
  supplierID INTEGER,
  isActive BOOLEAN DEFAULT 1,
  lastUpdated DATETIME DEFAULT CURRENT_TIMESTAMP,

  FOREIGN KEY (supplierID) REFERENCES Supplier(supplierID)
);

CREATE TABLE POrders (
  pOrderID INTEGER PRIMARY KEY AUTOINCREMENT,
  componentID INTEGER NOT NULL,
  supplierID INTEGER NOT NULL,
  quantity INTEGER NOT NULL,
  finalPrice DECIMAL(10, 2) NOT NULL, 
  deliveryDate DATETIME,
  status TEXT CHECK(status IN ('pending', 'in production', 'in stock', 'delivered', 'paid')) DEFAULT 'pending',
  purchasingDate DATETIME DEFAULT CURRENT_TIMESTAMP,
  isActive BOOLEAN DEFAULT 1,
  wasCancelled BOOLEAN DEFAULT 0,

  CONSTRAINT check_quantity_positive CHECK (quantity > 0), 

  FOREIGN KEY (componentID) REFERENCES Components(componentID),
  FOREIGN KEY (supplierID) REFERENCES Supplier(supplierID)
);


-- tables SALES (ERP)

CREATE TABLE Customers (	-- also includes debtor files
  -- customer details
  customerID INTEGER PRIMARY KEY AUTOINCREMENT,
  --  debtorID INTEGER,		
  companyName TEXT NOT NULL,
  streetAddress TEXT NOT NULL,
  postcode TEXT NOT NULL,
  city TEXT NOT NULL,
  state TEXT NOT NULL,
  country TEXT NOT NULL,
  
  -- contact person
  firstName TEXT NOT NULL,
  lastName TEXT NOT NULL,
  email TEXT UNIQUE NOT NULL,
  telephone TEXT NOT NULL,
  
  -- debtor details
  ibancode TEXT,
  currentBalance DECIMAL(15, 2) NOT NULL DEFAULT 0.00,
  category TEXT CHECK(category IN ('B2C customer', 'B2B customer', 'government', 'affiliates')) DEFAULT 'B2C customer',

  -- is company still customer
  isActive BOOLEAN DEFAULT 1,
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE Products (
  productID INTEGER PRIMARY KEY AUTOINCREMENT,
  productName TEXT NOT NULL,
  currentProductVersion INTEGER NOT NULL,
  standardPrice DECIMAL(10, 2) NOT NULL, -- The default MSRP
  costPerUnit DECIMAL(10, 2) NOT NULL,
      
  -- fixed costs
  laborCost DECIMAL(10, 2) NOT NULL,        -- entered manually
  overheadCost DECIMAL(10, 2) DEFAULT 0.00, -- electricity, rent, etc.

  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE CustomerDiscount (
  customerID INTEGER NOT NULL,
  productID INTEGER NOT NULL,
  discount Integer NOT NULL DEFAULT 0,
  
  PRIMARY KEY (customerID, productID),
  FOREIGN KEY (customerID) REFERENCES Customers(customerID),
  FOREIGN KEY (productID) REFERENCES Products(productID)
);

CREATE TABLE PriceHistory (
  -- history details
  productHistoryID INTEGER PRIMARY KEY AUTOINCREMENT,
  productID INTEGER NOT NULL,
  oldPrice DECIMAL(10, 2) NOT NULL,
  startDate DATETIME NOT NULL,
  endDate DATETIME,
  
  -- links to product
  FOREIGN KEY (productID) REFERENCES Products(productID) ON DELETE RESTRICT,
  
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE QuantityDiscounts (
  discountID INTEGER PRIMARY KEY AUTOINCREMENT,
  productID INTEGER NOT NULL,
  minQuantity INTEGER NOT NULL,
  discountPrice DECIMAL(10, 2),
  
  FOREIGN KEY (productID) REFERENCES Products(productID) ON DELETE CASCADE
);

CREATE TABLE COrders (
  cOrderID INTEGER PRIMARY KEY AUTOINCREMENT,
  productID INTEGER NOT NULL,
  customerID INTEGER NOT NULL,
  quantity INTEGER NOT NULL,
  finalPrice DECIMAL(10, 2) NOT NULL, 
  profit DECIMAL(15, 2) NOT NULL,
  deliveryDate DATETIME,
  status TEXT CHECK(status IN ('pending', 'in production', 'in stock', 'delivered', 'paid')) DEFAULT 'pending',
  saleDate DATETIME DEFAULT CURRENT_TIMESTAMP,
  isActive BOOLEAN DEFAULT 1,
  wasCancelled BOOLEAN DEFAULT 0,

  CONSTRAINT check_quantity_positive CHECK (quantity > 0), 

  FOREIGN KEY (productID) REFERENCES Products(productID),
  FOREIGN KEY (customerID) REFERENCES Customers(customerID)
);

-- tables for Accounting (ERP)

CREATE TABLE BankAccounts (
  accountID INTEGER PRIMARY KEY AUTOINCREMENT,
  accountName TEXT NOT NULL,
  ibancode TEXT,
  currentBalance DECIMAL(15, 2) DEFAULT 0.00,
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE BankAccountsHistory (
  logID INTEGER PRIMARY KEY AUTOINCREMENT,
  accountID INTEGER NOT NULL,
  balance DECIMAL(15, 2) NOT NULL,
  createdAt DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (accountID) REFERENCES BankAccounts(accountID)
);

